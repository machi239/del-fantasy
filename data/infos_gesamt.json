 "risiken": [
  {
   "text": "Torhüter Jonas Neffin (Berlin) ist kein sicherer Starter. Berlin rotiert mit Jack LaFontaine (startete am 25.10.) und spielt am Freitag in Ingolstadt; Alternative zum gleichen Preis: Adam Scheel (Frankfurt, 2 Pucks), zuletzt Stammtorhüter.",
   "schwer": false
  },
  {
   "text": "Dominik Kahun (München) fällt bis nach der Länderspielpause aus. Unterkörperverletzung, Rückkehr frühestens am 13.11.; verpasst auch den Deutschland Cup.",
   "schwer": true,
   "bis": "2026-11-13"
  },
  {
   "text": "Austin Ortega (Schwenningen) fällt mehrere Wochen aus. Operation am 19.10. laut Verein gut verlaufen; Neuzugang Connor Bunnaman debütierte am 23.10.",
   "schwer": true,
   "bis": "2026-11-15"
  },
  {
   "text": "Schwenningen ohne Schreiner, Lebster, Phil Hungerecker und Uvira bis nach der Länderspielpause. Beim 0:6 in Krefeld am 28.10. als verletzt geführt; Trivellato und Hempel wieder dabei, Höfflin, Feist und Hänelt spielten.",
   "schwer": true,
   "bis": "2026-11-13"
  },
  {
   "text": "Straubing ohne Torhüter Florian Bugl. Unterkörperverletzung vom 09.10., fällt laut Verein langfristig aus; Skarek spielt seitdem jedes Spiel, Backup Pantkowski.",
   "schwer": true,
   "bis": "2026-11-30"
  },
  {
   "text": "Nino Kinder (Bremerhaven) fällt bis zur Deutschland-Cup-Pause aus. Verletzt am 11.10., erhoffte Rückkehr am 13.11.",
   "schwer": true,
   "bis": "2026-11-13"
  },
  {
   "text": "Iserlohn ohne Maximilian Eisenmenger. Unterkörperverletzung vom 04.10., Ausfall bis nach der Deutschland-Cup-Pause.",
   "schwer": false,
   "bis": "2026-11-15"
  },
  {
   "text": "Bremerhaven mit vielen Ausfällen. Krämmer, Rausch und Roßmy Saison-Aus, Bettahar, Kechter, Boos und Broadhurst länger raus; Eminger fehlte am 23.10. angeschlagen.",
   "schwer": true,
   "bis": "2026-11-08"
  },
  {
   "text": "Rausch, Roßmy und Krämmer (Bremerhaven) Saison-Aus. Schwere Knieverletzungen.",
   "schwer": true,
   "bis": "2027-03-07"
  },
  {
   "text": "Chris Jandric (Nürnberg) fällt rund sechs Wochen aus. Knieverletzung vom 02.10.",
   "schwer": true,
   "bis": "2026-11-13"
  },
  {
   "text": "Jakob Weber (Nürnberg) noch nicht zurück. Fußverletzung vom 24.09. (4–6 Wochen), fehlte auch am 23.10.; eher Rückkehr nach der Pause.",
   "schwer": true,
   "bis": "2026-11-05"
  },
  {
   "text": "Chris DeSousa (München) fällt weiter aus. Oberkörperverletzung seit Saisonauftakt, laut Vorschau vom 21.10. kein Rückkehrdatum; am 23.10. nicht im Lineup.",
   "schwer": true,
   "bis": "2026-11-01"
  },
  {
   "text": "Philipp Krening (München) fällt lange aus. Unterkörperverletzung, frühestens nach der Deutschland-Cup-Pause zurück.",
   "schwer": false,
   "bis": "2026-12-15"
  },
  {
   "text": "Moritz Kukuk (Straubing) nach Krankheit vorerst in der DEL2. Er sammelt Spielpraxis bei den Eisbären Regensburg.",
   "schwer": false,
   "bis": "2026-10-31"
  },
  {
   "text": "Kris Bennett (Mannheim) fällt vier bis sechs Wochen aus. Unterkörperverletzung vom 25.09., Rückkehr noch nicht gemeldet.",
   "schwer": true,
   "bis": "2026-11-06"
  },
  {
   "text": "Julian Chrobot (Wolfsburg) fällt monatelang aus. Kreuzbandverletzung aus der Vorbereitung.",
   "schwer": false,
   "bis": "2027-01-31"
  },
  {
   "text": "Ingolstadt ohne Barber, Smallwood und Rosa-Preto. Barber fehlte seit 18.10. angeschlagen; Torhüter Stettmer und Williams wechseln sich ab (Williams startete am 25.10.).",
   "schwer": false,
   "bis": "2026-10-31"
  },
  {
   "text": "Jakin Smallwood (Ingolstadt) mehrere Monate raus. Oberkörperverletzung vom Saisonauftakt.",
   "schwer": false,
   "bis": "2026-12-15"
  },
  {
   "text": "Augsburg ohne Sean Malone, D.J. Busdeker und Luke Toporowski bis nach dem Deutschland Cup. Alle drei fehlten beim 3:2 n. V. gegen Frankfurt am 29.10.; Torhüter Ancicka startete statt Peyton Jones, beide rotieren.",
   "schwer": false,
   "bis": "2026-11-13"
  },
  {
   "text": "Kevin Wall nicht mehr in Krefeld. Vertrag am 22.09. aufgelöst; Nachfolger Phil Varone (ID 2631) spielt seit 02.10.",
   "schwer": false,
   "bis": "2027-03-07"
  },
  {
   "text": "Daniel Pfaffengut (Frankfurt) fällt weiter aus. Oberkörperverletzung vom 04.10., fehlte auch am 29.10. in Augsburg; Biro ebenfalls weiter nicht dabei.",
   "schwer": false,
   "bis": "2026-11-13"
  },
  {
   "text": "Daniel Wirt (Frankfurt) fällt zwei bis drei Monate aus. Oberkörperverletzung, am 21.10. operiert.",
   "schwer": false,
   "bis": "2027-01-15"
  },
  {
   "text": "Danjo Leonhardt (Straubing) fällt weiter aus. Oberkörperverletzung vom 25.09., laut Vorbericht vom 26.10. weiter raus.",
   "schwer": false,
   "bis": "2026-11-13"
  },
  {
   "text": "Mathias Niederberger (München) fällt voraussichtlich bis Jahresende aus. Unterkörperverletzung vom 23.10. laut Vereinsmeldung vom 27.10.; Bibeau ist die Nummer 1.",
   "schwer": false,
   "bis": "2026-12-31"
  },
  {
   "text": "Maksim Matushkin (Frankfurt) fällt rund drei Monate aus. Unterkörperverletzung aus dem letzten Heimspiel, Meldung vom 27.10.",
   "schwer": false,
   "bis": "2027-01-27"
  },
  {
   "text": "Köln ohne Torhüter Brückmann und Stürmer MacInnis. Beide fehlten am 27.10. gegen Mannheim (5:6 n. V.); Noebels, MacLeod und Niedenz sind zurück. Juvonen ist die Nummer 1; Luca Münzenberger nach Kassel gewechselt.",
   "schwer": false,
   "bis": "2026-11-13"
  },
  {
   "text": "Rio Kaiser (München) fällt bis Anfang 2027 aus. Unterkörperverletzung, zugezogen beim Einsatz für Riessersee, Meldung vom 30.10.",
   "schwer": false,
   "bis": "2027-01-15"
  },
  {
   "text": "Maximilian Glötzl gesperrt. 2 Spiel(e) laut DEL-Strafbank (gemeldet 2026-10-30), letztes gesperrtes Spiel am 2026-11-13.",
   "schwer": true
  }
