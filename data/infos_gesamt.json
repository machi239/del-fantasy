 "risiken": [
  {
   "text": "Ryan Murphy (München) fällt mehrere Wochen aus. Unterkörperverletzung, laut Vereinsmeldung vom 25.11. mindestens zehn DEL-Spiele.",
   "schwer": true,
   "bis": "2027-01-03"
  },
  {
   "text": "Max Calce verlässt Mannheim. Wechsel zu den Brantford Bulldogs (OHL) laut Vereinsmeldung.",
   "schwer": true,
   "bis": "2027-03-07"
  },
  {
   "text": "Reed Lebster (Schwenningen) fällt diese Woche aus. Verpasst laut Vorschau vom 25.11. alle drei Spiele bis 29.11., Update nächste Woche.",
   "schwer": false,
   "bis": "2026-11-30"
  },
  {
   "text": "Moritz Kukuk (Straubing) weiter krank. Seit 16.09. auf unbestimmte Zeit mit Virusinfekt raus; Kersten und Madden angeschlagen, Bugl und Leonhardt fallen weiter aus.",
   "schwer": false,
   "bis": "2026-12-31"
  },
  {
   "text": "Bremerhaven weiter ohne Reinwald, Boos und Bettahar. Eminger, Verlic, Byström und Kechter spielten am 24.11.",
   "schwer": false,
   "bis": "2026-12-06"
  },
  {
   "text": "Chris DeSousa (München) fällt weiter aus. Oberkörperverletzung laut Vereinsmeldung vom 25.11.; Dominik Kahun feierte am 25.11. sein Comeback und traf.",
   "schwer": true,
   "bis": "2026-11-29"
  },
  {
   "text": "Straubing ohne Torhüter Florian Bugl. Unterkörperverletzung, fällt längerfristig aus; Skarek startete am 22.11. wieder, Starter gegen Mannheim nicht angekündigt.",
   "schwer": true,
   "bis": "2026-12-31"
  },
  {
   "text": "Iserlohns Maximilian Eisenmenger fraglich. Fußbruch; am 22.11. stand ein Eisenmenger im Aufgebot, möglicherweise Bruder Magnus.",
   "schwer": false,
   "bis": "2026-11-29"
  },
  {
   "text": "Jonas Müller (Berlin) fällt langfristig aus. Laut Eisbären-Meldung vom 19.11. krankheitsbedingt auf unbestimmte Zeit.",
   "schwer": true,
   "bis": "2026-12-31"
  },
  {
   "text": "Fabio Wagner (München) fällt mehrere Wochen aus. Unterkörperverletzung beim Länderspiel am 08.11., Vereinsmeldung vom 12.11.",
   "schwer": true,
   "bis": "2026-12-06"
  },
  {
   "text": "Rausch, Roßmy und Krämmer (Bremerhaven) Saison-Aus. Schwere Knieverletzungen.",
   "schwer": true,
   "bis": "2027-03-07"
  },
  {
   "text": "Julian Chrobot (Wolfsburg) fällt monatelang aus. Kreuzbandverletzung aus der Vorbereitung.",
   "schwer": false,
   "bis": "2027-01-31"
  },
  {
   "text": "Jakin Smallwood (Ingolstadt) mehrere Monate raus. Oberkörperverletzung vom Saisonauftakt.",
   "schwer": false,
   "bis": "2026-12-15"
  },
  {
   "text": "Kevin Wall nicht mehr in Krefeld. Vertrag am 22.09. aufgelöst; Nachfolger Phil Varone (ID 2631) spielt seit 02.10.",
   "schwer": false,
   "bis": "2027-03-07"
  },
  {
   "text": "Daniel Wirt (Frankfurt) fällt zwei bis drei Monate aus. Oberkörperverletzung, am 21.10. operiert.",
   "schwer": false,
   "bis": "2027-01-15"
  },
  {
   "text": "Straubing weiter ohne Danjo Leonhardt. Tyler Madden und Spencer Kersten angeschlagen, fehlten am 24.11.",
   "schwer": false,
   "bis": "2026-11-30"
  },
  {
   "text": "Mathias Niederberger (München) fällt voraussichtlich bis Jahresende aus. Unterkörperverletzung vom 23.10. laut Vereinsmeldung vom 27.10.; Bibeau ist die Nummer 1.",
   "schwer": false,
   "bis": "2026-12-31"
  },
  {
   "text": "Maksim Matushkin (Frankfurt) fällt rund drei Monate aus. Unterkörperverletzung aus dem letzten Heimspiel, Meldung vom 27.10.",
   "schwer": false,
   "bis": "2027-01-27"
  },
  {
   "text": "Rio Kaiser (München) fällt bis Anfang 2027 aus. Unterkörperverletzung, zugezogen beim Einsatz für Riessersee, Meldung vom 30.10.",
   "schwer": false,
   "bis": "2027-01-15"
  },
  {
   "text": "Nathan Burns und Nicolas Appendino (Ingolstadt) fallen aus. Laut ERC-Vorschau vom 19.11. verletzt, ohne Rückkehrdatum; Williams startete am 22.11. statt Stettmer.",
   "schwer": false,
   "bis": "2026-11-30"
  },
  {
   "text": "Philipp Krauß (Augsburg) fällt wochenlang aus. Oberkörperverletzung, Operation laut AEV-Meldung vom 23.11.; Sean Malone fehlte am 24.11. weiter, Peyton Jones kurzfristig nicht verfügbar.",
   "schwer": false,
   "bis": "2026-12-20"
  },
  {
   "text": "Brandon Biro (Frankfurt) verletzt. Am 20.11. verletzt ausgeschieden, am 22.11. nicht im Aufgebot.",
   "schwer": false,
   "bis": "2026-11-30"
  }
 ],
