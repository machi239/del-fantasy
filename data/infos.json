 "risiken": [
  {
   "text": "Hendrik Hane (Iserlohn, in der Aufstellung) ist kein sicherer Starter. Am 20.11. in Wolfsburg stand Jenike im Tor (2:7), Hane startete zuvor am 15.11.; Iserlohn wechselt oft zwischen Freitag und Sonntag, Startwahrscheinlichkeit Hane etwa 65 %. Alternative zum gleichen Preis: Juha Jatkola (Krefeld, 2 Pucks), allerdings ebenfalls unsicher (Bick startete am 19.11.).",
   "schwer": false
  },
  {
   "text": "Torhüterfrage in Krefeld offen. Bick startete am 19.11. gegen Straubing und wurde gelobt, Jatkola war Backup; vorher stand meist Jatkola im Tor.",
   "schwer": false
  },
  {
   "text": "Wolfsburg wechselte im Tor. Am 20.11. startete Weitzmann (7:2 gegen Iserlohn), Strahlmeier war nur Backup.",
   "schwer": false
  },
  {
   "text": "Berlin rotiert im Tor. LaFontaine startete am 20.11., Neffin (die drei Spiele davor) war Backup; Starter in Straubing nicht angekündigt.",
   "schwer": false
  },
  {
   "text": "Austin Ortega (Schwenningen) vor Comeback. Laut Trainer Walker (19.11.) ist Sonntag gegen Augsburg ein realistischer Rückkehrtermin; Bittner, Trivellato und Uvira waren am 20.11. überzählig.",
   "schwer": false
  },
  {
   "text": "Patrick Brown (Mannheim) droht eine Sperre. Matchstrafe am 20.11. in Bremerhaven für einen Check gegen Ludwig Byström, der verletzt ausschied; Mannheim lief nur mit 17 Feldspielern auf.",
   "schwer": false
  },
  {
   "text": "Bremerhaven weiter ohne Reinwald, Boos und Bettahar. Kechter ist seit 20.11. zurück; Byström am 20.11. verletzt ausgeschieden.",
   "schwer": false,
   "bis": "2026-12-06"
  },
  {
   "text": "Dominik Kahun und Chris DeSousa (München) fallen weiter aus. Beide auch am 20.11. gegen Köln nicht im Aufgebot, Rückkehrtermin offen.",
   "schwer": true,
   "bis": "2026-11-29"
  },
  {
   "text": "Straubing ohne Torhüter Florian Bugl. Unterkörperverletzung, fällt längerfristig aus; Pantkowski startete am 15.11. und 19.11., Starter gegen Berlin nicht angekündigt.",
   "schwer": true,
   "bis": "2026-11-30"
  },
  {
   "text": "Iserlohn ohne Maximilian Eisenmenger. Fußbruch; laut Roosters (19.11.) kommt eine Rückkehr an diesem Wochenende zu früh.",
   "schwer": false,
   "bis": "2026-11-29"
  },
  {
   "text": "Sean Malone (Augsburg) weiter verletzt. Laut Panther am 20.11. einziger Ausfall, Dauer offen.",
   "schwer": false
  },
  {
   "text": "Frankfurt mit neuen Sorgen. Brandon Biro blieb am 20.11. im letzten Drittel in der Kabine, Cody Brenner fehlt aus persönlichen Gründen, Leden fehlte ohne genannten Grund.",
   "schwer": false
  },
  {
   "text": "Jonas Müller (Berlin) fällt langfristig aus. Laut Eisbären-Meldung vom 19.11. krankheitsbedingt auf unbestimmte Zeit.",
   "schwer": true,
   "bis": "2026-12-31"
  },
  {
   "text": "Fabio Wagner (München) fällt mehrere Wochen aus. Unterkörperverletzung beim Länderspiel am 08.11., Vereinsmeldung vom 12.11.",
   "schwer": true,
   "bis": "2026-12-06"
  },
  {
   "text": "Rausch, Roßmy und Krämmer (Bremerhaven) Saison-Aus. Schwere Knieverletzungen.",
   "schwer": true,
   "bis": "2027-03-07"
  },
  {
   "text": "Julian Chrobot (Wolfsburg) fällt monatelang aus. Kreuzbandverletzung aus der Vorbereitung.",
   "schwer": false,
   "bis": "2027-01-31"
  },
  {
   "text": "Jakin Smallwood (Ingolstadt) mehrere Monate raus. Oberkörperverletzung vom Saisonauftakt.",
   "schwer": false,
   "bis": "2026-12-15"
  },
  {
   "text": "Kevin Wall nicht mehr in Krefeld. Vertrag am 22.09. aufgelöst; Nachfolger Phil Varone (ID 2631) spielt seit 02.10.",
   "schwer": false,
   "bis": "2027-03-07"
  },
  {
   "text": "Daniel Wirt (Frankfurt) fällt zwei bis drei Monate aus. Oberkörperverletzung, am 21.10. operiert.",
   "schwer": false,
   "bis": "2027-01-15"
  },
  {
   "text": "Straubing weiter ohne Danjo Leonhardt. Laut Vereinsvorschau vom 18.11. steht Leonhardt weiter nicht zur Verfügung; Madden, Brandl und Kukuk fehlten am 15.11. ohne genannten Grund, Bugl fällt längerfristig aus.",
   "schwer": false,
   "bis": "2026-11-30"
  },
  {
   "text": "Mathias Niederberger (München) fällt voraussichtlich bis Jahresende aus. Unterkörperverletzung vom 23.10. laut Vereinsmeldung vom 27.10.; Bibeau ist die Nummer 1.",
   "schwer": false,
   "bis": "2026-12-31"
  },
  {
   "text": "Maksim Matushkin (Frankfurt) fällt rund drei Monate aus. Unterkörperverletzung aus dem letzten Heimspiel, Meldung vom 27.10.",
   "schwer": false,
   "bis": "2027-01-27"
  },
  {
   "text": "Rio Kaiser (München) fällt bis Anfang 2027 aus. Unterkörperverletzung, zugezogen beim Einsatz für Riessersee, Meldung vom 30.10.",
   "schwer": false,
   "bis": "2027-01-15"
  },
  {
   "text": "Nathan Burns (Ingolstadt) fällt auf unbestimmte Zeit aus. Oberkörperverletzung laut Vorschau vom 14.11.; Ruopp spielt wieder (20.11.).",
   "schwer": false,
   "bis": "2026-11-30"
  }
 ],
